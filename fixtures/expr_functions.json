                    "@code": "eventValue",
                    "@lang": "rust"
                  }
                }
              }
            ]
          },
          "CANCEL": {
            "@code": "cancelLater",
            "@lang": "rust"
          },
          "TWICE": {
            "actions": [
              {
                "@code": "emitTwice",
                "@lang": "rust"
              },
              {
                "type": "@xstate.emit",
                "event": {
                  "type": "after",
                  "count": {
                    "@code": "countPlusOne",
                    "@lang": "rust"
                  }
                }
              }
            ]
          },
          "NEST": {
            "target": "nest"
          }
        }
      },
      "positive": {
        "entry": [
          {
            "type": "@xstate.emit",
            "event": {
              "type": "enter.positive"
            }
          }
        ],
        "on": {
          "BACK": {
            "target": "a"
          }
        }
      },
      "negative": {
        "id": "fn.negative",
