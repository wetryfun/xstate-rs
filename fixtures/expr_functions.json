{
  "notes": "Rust transition functions (dynamic targets, context and reenter; not enabled when they return nothing and enqueue nothing), enq in transition functions and action expressions (raise, delayed raise, cancel, emit), and route functions.",
  "machine": {
    "id": "fn",
    "context": {
      "count": 0
    },
    "initial": "a",
