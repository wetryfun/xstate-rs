        "states": {
          "inner": {
            "entry": [
              {
                "type": "@xstate.emit",
                "event": {
                  "type": "enter.inner"
                }
              }
            ],
            "exit": [
              {
                "type": "@xstate.emit",
                "event": {
                  "type": "exit.inner"
                }
              }
            ]
          }
        },
        "on": {
          "AGAIN": {
