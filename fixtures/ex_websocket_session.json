                "params": {
                  "key": "received",
                  "value": 0
                }
              },
              "context": {
                "received": 1
              },
              "actions": [
                {
                  "type": "@xstate.emit",
                  "event": {
                    "type": "log",
                    "message": "clientMessage"
                  }
