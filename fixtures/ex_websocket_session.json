{
  "source": "examples/websocket-server/src/main.ts (sessionMachine)",
  "notes": "context from input is static; the user is set by matches on two users; the broadcast echo filter is @xstate.not over ctxEquals; received is unrolled per value; transport calls are emits; the server machine uses enq.spawn and is not portable",
  "machine": {
    "id": "session",
    "context": {
      "sessionId": "s1",
      "user": "anonymous",
      "received": 0
    },
    "initial": "handshake",
    "on": {
      "disconnect": {
        "target": ".closed"
      }
    },
    "states": {
      "handshake": {
        "after": {
          "900": {
            "target": "closing"
          }
        },
        "on": {
          "hello": [
            {
              "target": "active",
              "matches": {
                "user": "ada"
              },
              "context": {
                "user": "ada"
              },
              "actions": [
                {
                  "type": "@xstate.emit",
                  "event": {
                    "type": "sendToClient",
                    "message": "welcome"
                  }
                }
              ]
            },
            {
              "target": "active",
              "matches": {
                "user": "bob"
              },
              "context": {
                "user": "bob"
              },
              "actions": [
                {
                  "type": "@xstate.emit",
                  "event": {
                    "type": "sendToClient",
                    "message": "welcome"
                  }
                }
              ]
            }
          ]
        }
      },
