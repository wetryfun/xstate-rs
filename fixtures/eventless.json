{
  "machine": {
    "id": "e",
    "initial": "a",
    "context": { "ready": false, "step": 0 },
    "states": {
      "a": {
        "always": [{ "target": "b", "guard": { "type": "ctxEquals", "params": { "key": "ready", "value": true } } }],
        "on": { "ready": { "context": { "ready": true } } }
      },
      "b": {
        "entry": [{ "type": "@xstate.assign", "context": { "step": 1 } }, { "type": "@xstate.raise", "event": { "type": "kick" } }],
        "always": { "target": "c", "guard": { "type": "ctxEquals", "params": { "key": "step", "value": 2 } } },
        "on": { "kick": { "actions": [{ "type": "@xstate.assign", "context": { "step": 2 } }, { "type": "@xstate.emit", "event": { "type": "kicked" } }] } }
      },
      "c": {
        "always": { "actions": [{ "type": "@xstate.emit", "event": { "type": "once" } }] },
        "on": { "go": { "target": "d" } }
      },
      "d": { "always": { "target": "done" } },
      "done": { "type": "final" }
    }
  },
  "steps": [
    { "at": 0, "send": { "type": "nothing" } },
    { "at": 0, "send": { "type": "ready" } },
    { "at": 0, "send": { "type": "go" } }
  ]
}
