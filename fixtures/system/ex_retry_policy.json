{
 "source": "examples/pattern-retry-policy/src/main.ts",
 "notes": "A faithful port with Rust expressions: the context from input, the invoke input, the attempts counter and error (the source's onError function becomes a guarded pair, its guards.canRetry(attempts + 1) an expression guard), the exponential backoff delay (100 * 2^attempts), the log message and both outputs. MAX_ATTEMPTS = 5.",
 "logic": [
  {
   "name": "storePatient",
   "async": {}
  },
  {
   "name": "retry",
   "actors": [
    "storePatient"
   ],
   "machine": {
    "id": "retry",
    "context": {
     "@code": "retryContext",
     "@lang": "rust"
    },
    "delays": {
     "backoff": {
      "duration": {
       "@code": "backoff",
       "@lang": "rust"
      }
     }
    },
    "initial": "attempting",
    "states": {
     "attempting": {
      "invoke": {
       "src": "storePatient",
       "input": {
        "name": {
         "@code": "contextName",
         "@lang": "rust"
        }
       },
       "onDone": {
        "target": "stored",
        "context": {
         "recordId": {
          "@code": "outputRecordId",
          "@lang": "rust"
         }
        }
       },
       "onError": [
        {
         "guard": {
          "@code": "canRetry",
          "@lang": "rust"
         },
         "target": "backingOff",
         "context": {
          "attempts": {
           "@code": "attemptsPlusOne",
           "@lang": "rust"
          },
          "error": {
           "@code": "errorMessage",
           "@lang": "rust"
          }
         }
        },
        {
         "target": "gaveUp",
         "context": {
          "attempts": {
           "@code": "attemptsPlusOne",
           "@lang": "rust"
          },
          "error": {
           "@code": "errorMessage",
           "@lang": "rust"
          }
         }
        }
       ]
      }
     },
     "backingOff": {
      "entry": [
       {
        "type": "@xstate.emit",
        "event": {
         "type": "log",
         "message": {
          "@code": "retryMessage",
          "@lang": "rust"
         }
        }
       }
      ],
      "after": {
       "backoff": {
        "target": "attempting"
       }
      }
     },
     "stored": {
      "type": "final",
      "output": {
       "@code": "storedOutput",
       "@lang": "rust"
      }
     },
     "gaveUp": {
      "type": "final",
      "output": {
       "@code": "gaveUpOutput",
       "@lang": "rust"
      }
     }
    }
   }
  }
 ],
 "root": "retry",
 "init": {
  "input": {
   "name": "Ada Lovelace"
  }
 },
 "steps": [
  {
   "resolve": 0,
   "event": {
    "type": "xstate.async.reject",
    "data": {
     "message": "ServiceUnavailable"
    }
   }
  },
  {
   "advance": 199
  },
  {
   "advance": 200
  },
  {
   "resolve": 1,
   "event": {
    "type": "xstate.async.reject",
    "data": {
     "message": "ServiceUnavailable"
    }
   }
  },
  {
   "advance": 500
  },
  {
   "advance": 600
  },
  {
   "resolve": 2,
   "event": {
    "type": "xstate.async.reject",
    "data": {
     "message": "ServiceUnavailable"
    }
   }
  },
  {
   "advance": 1300
  },
  {
   "advance": 1400
  },
  {
   "resolve": 3,
   "event": {
    "type": "xstate.async.resolve",
    "data": {
     "recordId": "rec-4"
    }
   }
  }
 ]
}
