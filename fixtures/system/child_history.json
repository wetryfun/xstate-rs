              "a": { "on": { "next": { "target": "b" } } },
              "b": { "initial": "b1", "states": { "b1": { "on": { "next": { "target": "b2" } } }, "b2": {} } },
              "hist": { "type": "history", "history": "deep", "target": "a" }
