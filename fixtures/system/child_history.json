    {
      "name": "root",
      "actors": ["player"],
      "machine": { "id": "root", "initial": "a", "states": { "a": { "invoke": { "src": "player", "id": "p" } } } }
    }
  ],
  "root": "root",
  "steps": [
    { "send": "root/p", "event": { "type": "next" } },
    { "send": "root/p", "event": { "type": "next" } },
