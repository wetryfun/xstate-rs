    {
      "name": "trivia",
      "actors": [
        "loadHomePageCharacters",
        "loadSingleCharacter",
        "loadRandomCharacters"
      ],
      "machine": {
        "id": "triviaMachine",
        "initial": "homepage",
        "context": {
          "homePageCharacters": [],
          "hasLoaded": false,
          "isClueOpened": false,
          "currentCharacter": null,
          "randomCharacters": [],
          "points": 0,
          "question": 0,
          "lifes": 3
        },
        "states": {
          "homepage": {
            "initial": "loadingData",
            "states": {
              "loadingData": {
                "invoke": {
                  "src": "loadHomePageCharacters",
                  "onDone": {
                    "target": "dataLoaded",
                    "context": {
                      "homePageCharacters": [
                        {
                          "id": 1
                        },
                        {
                          "id": 2
                        }
                      ],
                      "hasLoaded": true
                    }
                  },
                  "onError": {
                    "target": "loadFailed"
                  }
                }
              },
              "loadFailed": {
                "entry": [
                  {
                    "type": "@xstate.assign",
                    "context": {
                      "hasLoaded": true
                    }
                  }
                ],
                "on": {
                  "user.retry": {
                    "target": "loadingData"
                  }
                }
              },
              "dataLoaded": {
                "on": {
                  "user.play": {
                    "target": "#instructionModal"
                  }
                }
              }
            }
          },
          "instructionModal": {
            "id": "instructionModal",
            "on": {
              "user.close": {
                "target": "homepage.dataLoaded"
              },
              "user.reject": {
                "target": "homepage.dataLoaded"
              },
              "user.accept": {
                "target": "startTrivia",
                "context": {
                  "hasLoaded": false
                }
              }
            }
          },
          "startTrivia": {
            "id": "startTrivia",
            "initial": "loadQuestionData",
            "entry": [
              {
                "type": "@xstate.assign",
                "context": {
                  "currentCharacter": null,
                  "randomCharacters": [],
                  "points": 0,
                  "question": 0,
                  "lifes": 3
                }
              }
            ],
            "states": {
              "loadQuestionData": {
                "id": "loadQuestionData",
                "initial": "loadCharacter",
                "entry": [
                  {
                    "type": "@xstate.assign",
                    "context": {
                      "hasLoaded": false
                    }
                  }
                ],
                "states": {
                  "loadCharacter": {
                    "invoke": {
                      "src": "loadSingleCharacter",
                      "onDone": {
                        "target": "loadRandomCharacters",
                        "context": {
                          "currentCharacter": {
                            "id": 7,
                            "name": "Rick"
                          }
                        }
                      },
                      "onError": {
                        "target": "#questionFailed"
                      }
                    }
                  },
                  "loadRandomCharacters": {
                    "invoke": {
                      "src": "loadRandomCharacters",
                      "onDone": [
                        {
                          "target": "#questionReady",
                          "guard": {
                            "type": "ctxEquals",
                            "params": {
                              "key": "question",
                              "value": 0
                            }
