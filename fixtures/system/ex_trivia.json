{
  "source": "examples/trivia-game-example/src/triviaMachine.ts",
  "notes": "a win at 30 points instead of 100; the correct answer is 7 (a static character); points, lifes and the question number are unrolled per value; entry assigns that computed from context moved onto the transitions; loaded data are static",
  "logic": [
    {
      "name": "loadHomePageCharacters",
      "async": {}
    },
    {
      "name": "loadSingleCharacter",
      "async": {}
    },
    {
      "name": "loadRandomCharacters",
      "async": {}
