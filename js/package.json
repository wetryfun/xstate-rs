{
  "name": "xmachines-broker-workspace",
  "private": true,
  "type": "module",
  "description": "@xmachines/broker packages: machines served from Kafka-API brokers over Web Streams",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --conditions=source --test packages/*/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -b packages/broker packages/broker-kafka packages/broker-redpanda"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.15.4",
    "@bytecodealliance/preview2-shim": "0.17.5",
    "@types/node": "22.19.1",
    "kafkajs": "2.2.4",
    "typescript": "5.9.3",
    "xstate": "6.0.0-alpha.70"
  }
}
